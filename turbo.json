{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^build:package",
        "^db:generate",
        "^generate:codegen"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "build:package": {
      "dependsOn": [
        "db:generate"
      ],
      "cache": false,
      "outputs": [
        "dist/**"
      ]
    },
    "schema:generate": {
      "dependsOn": [
        "^schema:generate"
      ],
      "cache": false,
      "outputs": [
        "schema.gql"
      ]
    },
    "generate:codegen": {
      "dependsOn": [
        "^schema:generate"
      ],
      "cache": false,
      "outputs": [
        "src/generated/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "dependsOn": [
        "^db:generate",
        "^build:package"
      ],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "outputs": [
        "src/generated/**"
      ]
    },
    "db:migrate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    }
  }
}