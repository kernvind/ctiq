# Template for the Hetzner VM deployment. On the VM:
#   cp .env.production.example .env.production && chmod 600 .env.production
# .env.production is gitignored — NEVER commit the filled-in version.

# Postgres (Supabase). Use the DIRECT connection (port 5432 / session mode) for DATABASE_URL —
# the 6543 transaction pooler breaks Prisma migrations and DDL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public
PG_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# openssl rand -base64 48
JWT_SECRET=<generate>
JWT_EXPIRES_IN=8h

# Shared internal token between api-core and inference-service. openssl rand -hex 32
SEARCH_API_TOKEN=<generate>

# Optional Hugging Face token for authenticated model downloads at image build
HF_TOKEN=

# Optional LLM query planner (inference-service). Unset = rule-based planner.
# OPENAI_API_KEY=

# Browser-facing GraphQL URL, baked into the web bundle at build time
NEXT_PUBLIC_API_URL=https://your-domain.example/graphql

# Only if you start the optional monitoring profile (`--profile monitoring`)
# GRAFANA_ADMIN_PASSWORD=<choose-a-strong-password>

# Defaults in docker-compose.hetzner.yml already match these — override only if routes change
# FAST_API_VERSION_V1=/api/v1
# FAST_API_SEARCH_TRIAL_PATH=/search/trials
