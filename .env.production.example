# Template for the Hetzner VM deployment. Copy to .env.production on the VM and fill in
# real values:  cp .env.production.example .env.production && chmod 600 .env.production
# .env.production is gitignored — NEVER commit the filled-in version.

# Supabase — same instance every ctiq deployment tier uses.
# Use the DIRECT connection (port 5432 / session mode), NOT the 6543 transaction pooler —
# the pooler breaks Prisma migrate / DDL (matches the Makefile migration warning).
DATABASE_URL=postgresql://<user>:<password>@<supabase-host>:5432/<db>?schema=public
PG_DATABASE_URL=postgresql://<user>:<password>@<supabase-host>:5432/<db>

JWT_SECRET=<generate-a-real-random-secret>
JWT_EXPIRES_IN=8h

# Shared internal token between api-core and inference-service (X-Internal-Token header).
SEARCH_API_TOKEN=<a-real-token-shared-between-api-core-and-inference-service>

# FastAPI route config read by api-core's trial-search service (required at runtime).
# Defaults in docker-compose.hetzner.yml already match these — only override if the
# inference service's routes change.
FAST_API_VERSION_V1=/api/v1
FAST_API_SEARCH_TRIAL_PATH=/search/trials

# Optional — only needed if the embedding model download should be authenticated against
# Hugging Face (e.g. you hit an anonymous-download rate limit). Leave blank otherwise.
HF_TOKEN=

# Currently has no runtime effect (baked at build, no client code reads it). Fine to leave blank.
NEXT_PUBLIC_API_URL=
