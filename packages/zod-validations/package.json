{
    "name": "@repo/zod-validations",
    "version": "0.0.0",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "rimraf dist && tsup",
        "dev": "tsup --watch",
        "postinstall": "tsup"
