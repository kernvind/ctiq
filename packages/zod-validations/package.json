            "import": "./dist/index.mjs"
        }
    },
    "dependencies": {
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "eslint": "^10.3.0",
        "rimraf": "^6.1.3",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}