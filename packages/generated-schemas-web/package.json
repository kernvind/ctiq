{
    "name": "@repo/generated-schemas-web",
    "version": "0.0.0",
    "private": true,
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "scripts": {
        "codegen": "tsx ./src/generate-operations.ts && graphql-codegen --config codegen.ts",
        "rmdist": "rimraf dist",
        "build": "graphql-codegen --config codegen.ts && rimraf dist && tsup",
        "generate:codegen": "pnpm run codegen && pnpm run build",
        "lint": "eslint"
    },
    "dependencies": {
        "graphql": "^16.14.0",
        "graphql-request": "^7.1.2",
        "graphql-tag": "^2.12.6"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^5.0.3",
        "@graphql-codegen/typescript": "^4.1.2",
        "@graphql-codegen/typescript-graphql-request": "^6.2.0",
        "@graphql-codegen/typescript-operations": "^4.4.0",
        "@graphql-tools/utils": "^11.1.0",
        "@swc/core": "^1.15.40",
        "@types/node": "^25.9.1",
        "concurrently": "^9.1.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "rimraf": "^6.1.3",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.mjs"
        }
    }
}