generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // User/auth domain lives in its own `app` schema, separate from the clinical-trial
  // domain (`trials`, owned by the Python ctiq-db package). multiSchema is GA in
  // Prisma 7, so no preview feature flag is needed.
  schemas  = ["app"]
}

/// The four ctiq personas. A user has exactly one role; defaults to PATIENT on signup
/// (elevated roles are assigned out-of-band, never self-selected at registration).
enum Role {
  PATIENT
  CLINICIAN
  ANALYST // pharma/biotech competitive-intelligence analyst
  ADMIN

  @@schema("app")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@schema("app")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  username String @unique

  /// @zod.string.min(1).max(255)
  passwordHash String

  name   String?
  role   Role       @default(PATIENT)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  @@schema("app")
}

/// Refresh-token sessions. Enables real logout and token revocation (stateless access
/// JWTs alone can't be revoked). Only the HASH of the refresh token is stored, never
/// the raw token.
model Session {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  userAgent String?
  ip        String?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@schema("app")
}
