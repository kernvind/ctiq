generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // User/auth domain lives in its own `app` schema, separate from the clinical-trial
  // domain (`trials`, owned by the Python ctiq-db package). multiSchema is GA in
  // Prisma 7, so no preview feature flag is needed.
  schemas  = ["app"]
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  username String @unique

  /// @zod.string.min(1).max(255)
  passwordHash String

  name  String?
  posts Post[]

  @@schema("app")
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])

  @@schema("app")
}
