generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // User/auth domain lives in its own `app` schema, separate from the clinical-trial
  // domain (`trials`, owned by the Python ctiq-db package). multiSchema is GA in
  // Prisma 7, so no preview feature flag is needed.
  schemas  = ["app"]
}

/// The four ctiq personas. A user has exactly one role; defaults to PATIENT on signup
/// (elevated roles are assigned out-of-band, never self-selected at registration).
enum Role {
  PATIENT
  CLINICIAN
  ANALYST // pharma/biotech competitive-intelligence analyst
  ADMIN

  @@schema("app")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@schema("app")
}

model User {
  id    String @id @default(cuid())
  email String @unique

  /// @zod.string.min(1).max(255)
  passwordHash String

  name   String?
  role   Role       @default(PATIENT)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  savedTrials     SavedTrial[]
  landscapes      Landscape[]
  portfolioTrials PortfolioTrial[]

  @@schema("app")
}

/// A saved "landscape": a named, re-runnable query an analyst monitors for new trials.
/// `spec` is an agent-ready JSON query (v1: { q, phase? } wrapping the semantic search) —
/// kept as JSON so the future NL-to-query agent can store richer specs without a schema
/// change. `lastSeenNctIds` + `lastCheckedAt` power the on-view "new since last check"
/// delta (the v1 monitoring loop; a scheduled agent replaces it later).
model Landscape {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  spec Json

  lastSeenNctIds String[]  @default([])
  lastCheckedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@schema("app")
}

/// A trial a user has bookmarked. `nctId` is a by-ID reference into the clinical-trial
/// domain (owned by ctiq-db), NOT a cross-ORM foreign key — the trial tables live in a
/// separate schema/ORM. One row per (user, trial); unique constraint makes saving
/// idempotent.
model SavedTrial {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  nctId  String

  createdAt DateTime @default(now())

  @@unique([userId, nctId])
  @@index([userId])
  @@schema("app")
}

/// A trial in a site's "open-trial portfolio" — the studies they are actively running and
/// want to enroll patients into (site-payer wedge). Same shape as SavedTrial but semantically
/// distinct (a running portfolio, not a personal bookmark). `nctId` is a by-ID reference into
/// the clinical-trial domain (ctiq-db), NOT a cross-ORM foreign key. One row per (user, trial);
/// the unique constraint makes adding idempotent. User-scoped for v1 (no org model yet).
model PortfolioTrial {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  nctId  String

  createdAt DateTime @default(now())

  @@unique([userId, nctId])
  @@index([userId])
  @@schema("app")
}

/// Refresh-token sessions. Enables real logout and token revocation (stateless access
/// JWTs alone can't be revoked). Only the HASH of the refresh token is stored, never
/// the raw token.
model Session {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  userAgent String?
  ip        String?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@schema("app")
}
