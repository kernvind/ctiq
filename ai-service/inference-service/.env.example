# inference-service — copy to .env (gitignored) and fill in. Never commit real values.

# Postgres, `trials` schema (SQLAlchemy). Use a LOCAL/DEV database for development.
PG_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME

# Shared secret api-core sends as X-Internal-Token — must equal api-core's SEARCH_API_TOKEN.
# Requests are rejected (503) while this is empty.
SEARCH_API_TOKEN=replace-with-a-random-token

# Optional: enables the LLM query planner. Without it the rule-based planner is used.
OPENAI_API_KEY=
# LLM_MODEL=gpt-5-mini
# QUERY_PLAN_CACHE_SIZE=512

# Hugging Face token (only needed for authenticated model downloads / Docker build)
# HF_TOKEN=

# Logging: LOG_FORMAT=json (default, one object per line) or text (readable, for local work)
LOG_LEVEL=INFO
LOG_FORMAT=text
