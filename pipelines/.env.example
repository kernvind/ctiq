# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=healthcare_ai
BQ_STAGING_TABLE=clinical_trials_gov_stg
BQ_EMBEDDINGS_TABLE=clinical_trials_gov_embeddings_stg
# Path to service account key JSON, or leave unset when using ADC / Workload Identity
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# GCS staging bucket (Parquet files land here before BQ load jobs read them)
GCS_BUCKET=your-staging-bucket
GCS_PREFIX=clinical_trials_gov_stg
GCS_EMBEDDINGS_PREFIX=clinical_trials_gov_embeddings_stg

# HuggingFace sentence-transformers (runs locally, no API key needed)
# Model is downloaded from HF Hub on first run → ~/.cache/huggingface/hub/
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
# 8192-token window → 6000-char chunks fit most trials in 1-2 chunks
EMBEDDING_CHUNK_SIZE=6000
EMBEDDING_CHUNK_OVERLAP=600
# 137 MB model; safe on CPU; raise to 64+ if running on GPU
EMBEDDING_BATCH_SIZE=32

# clinicalTrials.gov API
CT_API_BASE_URL=https://clinicaltrials.gov/api/v2
CT_API_PAGE_SIZE=1000
CT_API_MAX_RETRIES=5

# Parallelism — number of Dask worker threads
DASK_N_WORKERS=8
# Days per date-range chunk when splitting work across Dask workers
DATE_RANGE_CHUNK_DAYS=90

# BigQuery load batch size (rows per load job)
BQ_LOAD_BATCH_SIZE=5000
