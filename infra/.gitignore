# Terraform provider cache and plugins — large, regenerated by `terraform init`
**/.terraform/

# State files — never commit, state lives in GCS
*.tfstate
*.tfstate.backup

# Saved plan files — binary, never commit
tfplan
*.tfplan

# Crash logs
crash.log

# tfvars contain real project IDs and values — gitignored per environment
# Commit terraform.tfvars.example files instead to document required variables
terraform.tfvars
*.auto.tfvars
