{
  "name": "ctiq",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "build:package": "turbo run build:package",
    "generate:codegen": "turbo run generate:codegen",
    "schema:generate": "turbo run schema:generate",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.9.12",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=18"
  }
}