# Caddy reverse proxy — the only public-facing container on the VM.
# Caddy requests a Let's Encrypt cert via HTTP-01 over port 80 and auto-renews it.
# Requires an A record for hiq.kernvind.com pointing at the VM's public IP before first start.
hiq.kernvind.com {
	reverse_proxy web-dashboard:3000
}

# --- Local / no-DNS fallback: test over plain HTTP against the VM's IP. If you use this,
#     set COOKIE_SECURE=false in .env.production while on HTTP, then switch back.
# :80 {
# 	reverse_proxy web-dashboard:3000
# }
