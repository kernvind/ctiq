# api-core — copy to .env (gitignored) and fill in. Never commit real values.
PORT=3001

# Postgres, `app` schema (Prisma). Use a LOCAL/DEV database for development, never production.
# Transaction pooler (Supabase :6543) needs ?pgbouncer=true at runtime; run migrations over a
# direct connection (:5432) — see `make migrate-prisma`.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# inference-service location and the shared secret sent as X-Internal-Token.
# SEARCH_API_TOKEN must be identical in inference-service. Generate with: openssl rand -hex 32
SEARCH_API_URL=http://localhost:8000
SEARCH_API_TOKEN=replace-with-a-random-token

# Inference route config (must match inference-service's routers)
FAST_API_VERSION_V1=/api/v1
FAST_API_VERSION_V2=/api/v2
FAST_API_SEARCH_TRIAL_PATH=/search/trials
FAST_API_MATCH_PATH=/match/trials
FAST_API_MATCH_PORTFOLIO_PATH=/match/portfolio

# Optional
# LOG_LEVEL=debug
