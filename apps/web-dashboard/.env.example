# web-dashboard — copy to .env (gitignored).

# Server-side URL of api-core (runtime only; used by Next.js server code).
# In docker-compose this is http://api-core:3001
BACKEND_URL=http://localhost:3001

# Browser-facing GraphQL URL. NEXT_PUBLIC_* values are baked into the JS bundle at BUILD time.
NEXT_PUBLIC_API_URL=http://localhost:3001/graphql

# Set to true behind HTTPS (production). Use false for plain-HTTP local development.
COOKIE_SECURE=false
